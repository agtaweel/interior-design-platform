<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            force="true" on every entry below is load-bearing, not decoration: this project's
            docker-compose.yml sets `env_file: ./backend/.env` on the `app` service, which
            exports APP_ENV=local / DB_CONNECTION=pgsql / DB_DATABASE=interior_design_platform
            (etc.) as real OS environment variables on the container's process tree — including
            any `docker compose exec app ...` command, since `exec` inherits the container's
            environment. PHPUnit's <env> tag does NOT override an already-set OS environment
            variable unless force="true" is given. Without it, every entry here silently
            no-ops when tests are run via `docker compose exec app php artisan test` (the
            command documented in docs/PROJECT_CONTEXT.md) — APP_ENV stays "local" and
            DB_CONNECTION stays "pgsql", so RefreshDatabase-based tests migrate:fresh the REAL
            dev database instead of an in-memory sqlite one, silently destroying dev data on
            every test run. Confirmed experimentally while implementing Sprint 2's BOQ API.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="MEDIA_DISK" value="local" force="true"/>
        <env name="QUEUE_CONVERSIONS_BY_DEFAULT" value="false" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
